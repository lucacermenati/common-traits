{
	"name": "lucacermenati/common-traits",
	"description": "Reusable traits and interfaces for Laravel applications.",
	"keywords": [
		"laravel",
		"eloquent",
		"traits",
		"search",
		"filter",
		"sort",
		"upload"
	],
	"homepage": "https://github.com/lucacermenati/common-traits",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Luca Cermenati"
		}
	],
	"require": {
		"php": "^8.2",
		"illuminate/support": "^11.0 || ^12.0 || ^13.0",
		"illuminate/database": "^11.17 || ^12.0",
		"illuminate/http": "^11.0 || ^12.0"
	},
	"require-dev": {
		"orchestra/testbench": "^9.0 || ^10.0",
		"phpunit/phpunit": "^11.0"
	},
	"autoload": {
		"psr-4": {
			"LucaCermenati\\CommonTraits\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"LucaCermenati\\CommonTraits\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"scripts": {
		"test": "vendor/bin/phpunit"
	}
}
